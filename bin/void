#!/usr/bin/env bash
# void: xbps and runit wrapper for people coming from systemd.
# Bash only, nothing here needs a package Void does not already ship.

set -uo pipefail
export LC_ALL=C

PROG=${0##*/}
VERSION="1.0.0"

SV_DIR=${VOID_SV_DIR:-/etc/sv}
SERVICE_DIR=${VOID_SERVICE_DIR:-/var/service}
LOG_DIR=${VOID_LOG_DIR:-/var/log}
XBPS_CONF_DIR=${VOID_XBPS_CONF_DIR:-/etc/xbps.d}
XBPS_CACHE_DIR=${VOID_XBPS_CACHE_DIR:-/var/cache/xbps}

DRY_RUN=0
ASSUME_YES=0
QUIET=0
FORCE_NO_COLOR=0
SUDO_CMD=""

# Parallel downloading. JOBS is empty until something sets it; pkg_jobs
# resolves it against VOID_JOBS and the CPU count.
PARALLEL=1
JOBS=""

C_RESET=""
C_BOLD=""
C_DIM=""
C_RED=""
C_GREEN=""
C_YELLOW=""
C_BLUE=""
C_CYAN=""

# --- Output helpers --------------------------------------------------

setup_colors() {
    if (( FORCE_NO_COLOR )) || [[ -n ${NO_COLOR:-} ]] || [[ ! -t 1 ]]; then
        return 0
    fi
    C_RESET=$'\033[0m'
    C_BOLD=$'\033[1m'
    C_DIM=$'\033[2m'
    C_RED=$'\033[31m'
    C_GREEN=$'\033[32m'
    C_YELLOW=$'\033[33m'
    C_BLUE=$'\033[34m'
    C_CYAN=$'\033[36m'
}

info() {
    (( QUIET )) || printf '%s==>%s %s\n' "$C_BLUE" "$C_RESET" "$*"
}

ok() {
    (( QUIET )) && return 0
    if (( DRY_RUN )); then
        printf '%s[dry-run]%s %s\n' "$C_DIM" "$C_RESET" "$*"
    else
        printf '%sok:%s %s\n' "$C_GREEN" "$C_RESET" "$*"
    fi
}

note() {
    (( QUIET )) || printf '    %s\n' "$*"
}

warn() {
    printf '%swarning:%s %s\n' "$C_YELLOW" "$C_RESET" "$*" >&2
}

err() {
    printf '%serror:%s %s\n' "$C_RED" "$C_RESET" "$*" >&2
}

die() {
    err "$*"
    exit 1
}

have() {
    command -v "$1" >/dev/null 2>&1
}

# Run it, or print it under --dry-run.
run() {
    if (( DRY_RUN )); then
        printf '%s[dry-run]%s ' "$C_DIM" "$C_RESET" >&2
        printf '%q ' "$@" >&2
        printf '\n' >&2
        return 0
    fi
    "$@"
}

as_root() {
    if (( EUID == 0 )); then
        run "$@"
    else
        [[ -n $SUDO_CMD ]] || die "This action needs root. Install sudo/doas or run as root."
        run "$SUDO_CMD" "$@"
    fi
}

# as_root, for commands we need to read the output of.
root_output() {
    if (( EUID == 0 )); then
        "$@"
    else
        [[ -n $SUDO_CMD ]] || die "This action needs root. Install sudo/doas or run as root."
        "$SUDO_CMD" "$@"
    fi
}

confirm() {
    local prompt=$1 default=${2:-n} answer
    (( ASSUME_YES )) && return 0
    if [[ ! -t 0 ]]; then
        warn "Not running interactively; use --yes to confirm."
        return 1
    fi
    if [[ $default == y ]]; then
        prompt="$prompt [Y/n] "
    else
        prompt="$prompt [y/N] "
    fi
    read -r -p "$prompt" answer || return 1
    answer=${answer:-$default}
    [[ ${answer,,} == y* ]]
}

# --- Small utilities -------------------------------------------------

format_duration() {
    local seconds=${1:-0}
    [[ $seconds =~ ^[0-9]+$ ]] || seconds=0
    if (( seconds < 60 )); then
        printf '%ds' "$seconds"
    elif (( seconds < 3600 )); then
        printf '%dm' "$((seconds / 60))"
    elif (( seconds < 86400 )); then
        printf '%dh %dm' "$((seconds / 3600))" "$(((seconds % 3600) / 60))"
    else
        printf '%dd %dh' "$((seconds / 86400))" "$(((seconds % 86400) / 3600))"
    fi
}

is_void() {
    [[ -r /etc/os-release ]] && grep -Eq '^ID="?void"?$' /etc/os-release 2>/dev/null
}

require_void() {
    is_void || warn "This system does not identify as Void Linux; things may not work as expected."
}

require_xbps() {
    local missing=() tool
    for tool in xbps-install xbps-remove xbps-query xbps-pkgdb xbps-reconfigure; do
        have "$tool" || missing+=("$tool")
    done
    ((${#missing[@]} == 0)) || die "Missing XBPS tools: ${missing[*]}"
}

require_runit() {
    have sv || die "The 'sv' command is missing. Is runit installed?"
}

service_exists() {
    [[ -d "$SV_DIR/$1" ]]
}

service_enabled() {
    [[ -L "$SERVICE_DIR/$1" || -e "$SERVICE_DIR/$1" ]]
}

service_link_is_symlink() {
    [[ -L "$SERVICE_DIR/$1" ]]
}

state_color() {
    case "$1" in
        run)  printf '%s' "$C_GREEN" ;;
        down) printf '%s' "$C_YELLOW" ;;
        fail) printf '%s' "$C_RED" ;;
        off)  printf '%s' "$C_DIM" ;;
        *)    printf '%s' "$C_CYAN" ;;
    esac
}

# Rewrite sv status detail as "pid 123, up 2m".
format_sv_detail() {
    local detail=$1 state=$2
    if [[ $detail =~ \(pid\ ([0-9]+)\)\ ([0-9]+)s ]]; then
        printf 'pid %s, up %s' "${BASH_REMATCH[1]}" "$(format_duration "${BASH_REMATCH[2]}")"
    elif [[ $detail =~ ^([0-9]+)s$ ]]; then
        printf '%s for %s' "$state" "$(format_duration "${BASH_REMATCH[1]}")"
    elif [[ $detail =~ ^([0-9]+)s,\ (.*)$ ]]; then
        printf '%s for %s (%s)' "$state" \
            "$(format_duration "${BASH_REMATCH[1]}")" "${BASH_REMATCH[2]}"
    else
        printf '%s' "$detail"
    fi
}

# Wait for runsvdir to pick up a freshly linked service.
wait_for_supervise() {
    local name=$1 i
    (( DRY_RUN )) && return 0
    if [[ $SUDO_CMD == doas ]]; then
        sleep 1
        return 0
    fi
    for ((i = 0; i < 50; i++)); do
        if (( EUID == 0 )); then
            [[ -e "$SERVICE_DIR/$name/supervise/ok" ]] && return 0
        else
            "$SUDO_CMD" -n test -e "$SERVICE_DIR/$name/supervise/ok" 2>/dev/null && return 0
        fi
        sleep 0.2
    done
    return 1
}

# sv, quiet on success and verbose on failure.
sv_do_quiet() {
    local action=$1 name=$2 output
    if (( DRY_RUN )); then
        as_root sv "$action" "$name"
        return $?
    fi
    if output=$(root_output sv "$action" "$name" 2>&1); then
        return 0
    fi
    if [[ -n $output ]]; then
        printf '%s\n' "$output" | sed 's/^/  /' >&2
    fi
    return 1
}

# --- General help ----------------------------------------------------

usage() {
    cat <<'EOF'
void: xbps and runit helper for Void Linux

Usage:
  void <command> [options]

Packages (XBPS):
  void pkg install <pkg...>      Install one or more packages
  void pkg install -j <n> ...    Install with n parallel downloads
  void pkg remove <pkg...>       Remove packages          (alias: rm)
  void pkg update                Refresh repository indexes
  void pkg upgrade [pkg...]      Upgrade everything or selected packages
  void pkg search <term>         Search the repositories
  void pkg info <pkg>            Show package information
  void pkg list                  List installed packages
  void pkg autoremove            Remove orphan packages
  void pkg clean                 Clean the package cache
  void pkg hold <pkg>            Prevent a package from being upgraded
  void pkg repo available        Add third-party repositories by name
  void pkg repo add <name>       Enable a catalog repository
  void pkg help                  Show all package commands

Services (runit):
  void svc list                  Show enabled services and their state
  void svc status [name...]      Show detailed service status
  void svc start <name...>       Start a service (enables it if needed)
  void svc stop <name...>        Stop a service
  void svc restart <name...>     Restart a service
  void svc reload <name...>      Send SIGHUP to a service
  void svc enable [--now] <name> Enable a service at boot
  void svc disable <name...>     Stop and disable a service
  void svc logs <name>           Show a service's log
  void svc edit <name>           Edit a service's run script
  void svc create <name> --exec "command"
                                 Create a new runit service
  void svc help                  Show all service commands

System:
  void update                    Sync repositories and upgrade everything
  void info                      Show a system overview
  void logs [-f] <service>       View or follow service logs
  void doctor                    Check for common Void issues
  void cheat [topic]             systemd → Void translation table
  void repo list                 Show configured repositories
  void repo add <name>           Alias for "void pkg repo add"
  void desktop refresh           Rebuild desktop, icon and MIME caches

Global options:
  -n, --dry-run                  Print commands instead of running them
  -y, --yes                      Answer yes to prompts
  -q, --quiet                    Less output
      --no-color                 Disable colors (also respects NO_COLOR)

Examples:
  void pkg install neovim htop git
  void svc enable --now bluetoothd
  void logs -f NetworkManager
  void svc create myservice --exec "/usr/bin/myservice --flag" --enable
  void cheat systemctl

Void uses runit instead of systemd. Services are plain shell scripts in
/etc/sv/<name>, enabled by symlinking them into /var/service.
EOF
}

pkg_usage() {
    cat <<'EOF'
void pkg: package management with XBPS

Usage:
  void pkg <command> [options]

Commands:
  install <pkg...>       Install packages
  remove <pkg...>        Remove packages (alias: rm)
  update                 Refresh repository indexes only
  upgrade [pkg...]       Upgrade all or selected packages
  search <term>          Search repositories (--installed to search locally)
  info <pkg>             Show package details
  list                   List installed packages
  files <pkg>            List files owned by a package
  owns <path>            Find which package owns a path
  deps <pkg>             Show dependencies
  revdeps <pkg>          Show reverse dependencies
  hold <pkg>             Hold a package at its current version
  unhold <pkg>           Release a held package
  reconfigure <pkg>      Re-run a package's post-install configuration
  autoremove             Remove orphan packages
  clean                  Remove old packages from the cache
  repo                   Manage repositories and add third-party ones

Options:
  -y, --yes              Assume yes
  -n, --dry-run          Only print what would run
  -h, --help             Show this help

Install and upgrade options:
  -j, --jobs <n>         Parallel downloads to run at once (default: CPU count)
  -P, --parallel         Enable parallel downloading (default)
  --no-parallel          Download one package at a time, like plain xbps
  -f, --force            Force reinstallation

Parallel downloads
  XBPS fetches one archive at a time. void resolves the transaction first,
  pulls the missing archives concurrently, and leaves them in /var/cache/xbps
  so the real install finds them already on disk. Every archive is decompress
  tested before it is used, because a corrupt one in the cache makes
  xbps-install abort instead of retrying, and any failure falls back to a
  normal download. Set VOID_JOBS to change the default concurrency.

Examples:
  void pkg install firefox
  void pkg install neovim git -j 8
  void pkg upgrade --no-parallel
  void pkg search wayland
  void pkg list --manual
  void pkg autoremove
EOF
}

svc_usage() {
    cat <<'EOF'
void svc: managing runit services

Usage:
  void svc <command> [options]

Commands:
  list [--all]           List enabled services (--all includes available ones)
  status [name...]       Show detailed status
  start <name...>        Start a service; enables it first if necessary
  stop <name...>         Stop a service
  restart <name...>      Restart a service
  reload <name...>       Send SIGHUP to a service
  enable [--now] <name>  Enable a service at boot; --now also starts it
  disable <name...>      Stop and disable a service
  logs [-f] <name>       Show the service log
  edit <name>            Edit /etc/sv/<name>/run
  create <name> ...      Create a new service (see below)

Create options:
  --exec "command"       Command to run (required)
  --user user[:group]    Run as this user via chpst
  --no-log               Do not create an svlogd log service
  --enable               Enable and start the new service
  --yes                  Do not ask to enable it

Notes:
  runit has no "transient" services. `void svc start foo` enables foo
  first, so it will also start after a reboot. Use `void svc disable`
  if you do not want that.
  There is no daemon-reload: edit the run script and restart the service.

Examples:
  void svc list
  void svc enable --now bluetoothd
  void logs -f NetworkManager
  void svc create backup --exec "/usr/local/bin/backup --daemon"
EOF
}

